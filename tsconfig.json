{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "outDir": "./dist"
  },
  "include": ["tests/**/*.ts", "src/**/*.ts", "utils/**/*.ts"],
  "exclude": ["node_modules", "playwright-report", "allure-results", "test-results"]
}
